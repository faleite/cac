# Banco de Dados PostgreSQL
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=appdb

# Backend Node.js
PORT=3000
DATABASE_URL=postgresql://devuser:devpassword@db:5432/appdb?schema=public

# Sessão e Segurança
SESSION_SECRET=seu_segredo_de_sessao_aqui
NODE_ENV=development

# E-mail Transacional SMTP (Nodemailer / Mailtrap em dev)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@cacatividades.pt

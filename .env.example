# ==========================================
# CAC Atividades - Variáveis de Ambiente
# ==========================================

# Banco de Dados PostgreSQL
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=appdb

# Backend Node.js
PORT=3000
DATABASE_URL=postgresql://devuser:devpassword@db:5432/appdb?schema=public
APP_URL=http://localhost

# Sessão e Segurança
SESSION_SECRET=seu_segredo_de_sessao_super_seguro_aqui
NODE_ENV=development

# ==========================================
# E-mail Transacional - Brevo (Sendinblue)
# ==========================================
# Host SMTP oficial do Brevo:
SMTP_HOST=smtp-relay.brevo.com

# Porta SMTP recomendada: 587 (TLS/STARTTLS) ou 465 (SSL)
SMTP_PORT=587

# Usuário/Login SMTP fornecido pelo Brevo (na aba SMTP & API -> SMTP, campo "Login")
# Formato técnico gerado pelo Brevo (ex: bbf053001@smtp-brevo.com ou seu ID de login técnico)
SMTP_USER=bbf053001@smtp-brevo.com

# Chave SMTP Master gerada no Brevo (começa habitualmente com xsmtpsib-...)
SMTP_PASS=sua_chave_smtp_brevo_aqui

# Endereço de e-mail do remetente (DEVE estar validado em "Senders" no painel Brevo)
EMAIL_FROM=seu_remetente_verificado@dominio.com
